-- Основная логика
local teleportThread = nil
local isTeleporting = false
local guiVisible = true

local function TeleportToPortal()
    local character = player.Character
    if character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then
            humanoidRootPart.CFrame = CFrame.new(-74, 348, -1183)
            return true
        end
    end
    return false
end

local function StartAutoTeleport(interval)
    if teleportThread then
        coroutine.close(teleportThread)
        teleportThread = nil
    end
    
    teleportThread = coroutine.create(function()
        while isTeleporting do
            TeleportToPortal()
            wait(interval)
        end
    end)
    
    coroutine.resume(teleportThread)
end

-- Создаем GUI
local GUI = CreateOrionStyleGUI()

-- Обработчики событий
GUI.AutoToggle.MouseButton1Click:Connect(function()
    isTeleporting = not isTeleporting
    
    if isTeleporting then
        local interval = tonumber(GUI.IntervalBox.Text) or 3
        if interval < 0.5 then interval = 0.5 end
        
        GUI.AutoToggle.Text = "Автотелепорт: ВКЛ"
        GUI.AutoToggle.BackgroundColor3 = Color3.new(0, 0.5, 0)
        GUI.StatusLabel.Text = "Статус: Автотелепорт активен (" .. interval .. "с)"
        GUI.StatusLabel.TextColor3 = Color3.new(0, 1, 0)
        
        StartAutoTeleport(interval)
    else
        GUI.AutoToggle.Text = "Автотелепорт: ВЫКЛ"
        GUI.AutoToggle.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
        GUI.StatusLabel.Text = "Статус: Остановлен"
        GUI.StatusLabel.TextColor3 = Color3.new(1, 1, 1)
        
        if teleportThread then
            coroutine.close(teleportThread)
            teleportThread = nil
        end
    end
end)

GUI.TeleportBtn.MouseButton1Click:Connect(function()
    if TeleportToPortal() then
        GUI.StatusLabel.Text = "Статус: Успешно телепортирован!"
        GUI.StatusLabel.TextColor3 = Color3.new(0, 1, 0)
        
        wait(2)
        
        if isTeleporting then
            local interval = tonumber(GUI.IntervalBox.Text) or 3
            GUI.StatusLabel.Text = "Статус: Автотелепорт активен (" .. interval .. "с)"
        else
            GUI.StatusLabel.Text = "Статус: Готов к работе"
            GUI.StatusLabel.TextColor3 = Color3.new(1, 1, 1)
        end
    else
        GUI.StatusLabel.Text = "Статус: Ошибка телепортации"
        GUI.StatusLabel.TextColor3 = Color3.new(1, 0, 0)
    end
end)

GUI.HideBtn.MouseButton1Click:Connect(function()
    guiVisible = not guiVisible
    GUI.MainWindow.Visible = guiVisible
end)

GUI.CloseButton.MouseButton1Click:Connect(function()
    isTeleporting = false
    if teleportThread then
        coroutine.close(teleportThread)
        teleportThread = nil
    end
    GUI.ScreenGui:Destroy()
end)

